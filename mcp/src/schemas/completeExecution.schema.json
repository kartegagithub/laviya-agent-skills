{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.laviya.app/complete-execution.schema.json",
  "title": "CompleteExecutionPayload",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskID", "aiAgentFlowRunID", "aiAgentTaskExecutionID", "finalOutput"],
  "properties": {
    "taskID": { "type": "integer", "minimum": 1 },
    "aiAgentFlowRunID": { "type": "integer", "minimum": 1 },
    "aiAgentTaskExecutionID": { "type": "integer", "minimum": 1 },
    "requestKey": { "type": "string", "minLength": 1, "maxLength": 120 },
    "finalOutput": { "type": "string", "minLength": 1, "maxLength": 10485760 },
    "agentType": { "type": "string", "minLength": 1, "maxLength": 100 },
    "agentVersion": { "type": "string", "minLength": 1, "maxLength": 100 }
  }
}
